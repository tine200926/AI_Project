{
  "manifest_version": 3,
  "name": "虎航低價機票搜尋",
  "short_name": "虎航低價搜尋",
  "version": "1.0.0",
  "description": "設定目的地、來回或單程、旅遊天數、可出發期間與預算，一次找出台灣虎航最便宜的日期組合。非官方工具。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "虎航低價機票搜尋",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api-cms.tigerairtw.com/*",
    "https://api-book.tigerairtw.com/*"
  ]
}
