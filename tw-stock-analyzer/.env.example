# live = 抓真實資料（預設）；demo = 全部用模擬資料（畫面會標示「模擬資料」，數字不代表真實市場）
TWSA_DATA_MODE=live
# FinMind 免費註冊即可取得 token，可提高呼叫上限（沒有也能用，但每小時次數較少）
FINMIND_TOKEN=
# 選用：FinLab（付費資料源）；設定後財報／價格優先用 FinLab
FINLAB_API_TOKEN=
# 選用：AI Agent 與新聞 AI 解讀
ANTHROPIC_API_KEY=
TWSA_AI_MODEL=claude-opus-5-5
# 快取目錄與存活時間（秒）
TWSA_CACHE_DIR=.cache
TWSA_CACHE_TTL=21600
