{
  "manifest_version": 3,
  "name": "優惠券定時領取 for 賣貨便",
  "short_name": "優惠券定時領取",
  "version": "1.0.0",
  "description": "在指定時間自動打開 7-ELEVEN 賣貨便的領取優惠券頁面，對準網站時間到點重新整理，並自動點擊「領取」按鈕。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "優惠券定時領取",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://myship.7-11.com.tw/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://myship.7-11.com.tw/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://myship.7-11.com.tw/*"],
      "js": ["lib/core.js", "content.js"],
      "run_at": "document_end"
    }
  ]
}
